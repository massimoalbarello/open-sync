{
  "name": "open-sync",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "@better-auth/passkey": "^1.7.2",
      "better-auth": "^1.7.2",
      "typescript": "6.0.3"
    }
  },
  "scripts": {
    "dev": "bun run --bun turbo dev --filter=@repo/web",
    "dev:isolated": "bun run scripts/dev-isolated.ts",
    "dev:isolated:seeded": "bun run scripts/dev-isolated.ts --seed",
    "build": "bun run --bun turbo build --filter=@repo/web",
    "build:linux": "BUILD_TARGET=bun-linux-x64 bun run build",
    "deploy": "bun --filter @repo/web deploy",
    "check:types": "bun run --bun turbo check:types && bun run --bun tsc -p tsconfig.json",
    "check:codestyle": "bun run --bun biome check",
    "check:frontend": "node node_modules/eslint/bin/eslint.js apps/web/frontend/src",
    "check:backend": "node scripts/check-backend.mjs",
    "check:all": "bun run --parallel check:types check:codestyle check:frontend check:backend",
    "check:commit-message": "bun run --bun commitlint",
    "fix:codestyle": "bun run --bun biome check --write",
    "test": "bun test scripts/check-backend.test.ts && bun run --bun turbo test",
    "test:browser": "bun run scripts/test-browser.ts",
    "test:binary": "bun --filter @repo/web test:binary",
    "check:package": "bun run scripts/check-sync-package.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/format": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@repo/browser-testing": "workspace:*",
    "@shadcn/lint": "0.1.0",
    "@tanstack/eslint-plugin-query": "5.103.0",
    "@types/bun": "^1.4.0",
    "@typescript-eslint/parser": "8.70.0",
    "dependency-cruiser": "18.3.1",
    "eslint": "9.39.5",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": "1.4.0",
    "node": "^22.14.0 || >=24.0.0"
  },
  "packageManager": "bun@1.4.0"
}
