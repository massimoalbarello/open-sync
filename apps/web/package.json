{
  "name": "@repo/web",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --no-orphans --parallel dev:server dev:client",
    "dev:server": "bun run scripts/dev.ts",
    "dev:client": "vite --config frontend/vite.config.ts",
    "build": "bun run scripts/build.ts",
    "build:client": "bun --bun vite build --config frontend/vite.config.ts",
    "deploy": "bun run scripts/deploy.ts",
    "generate:queries": "bun --cwd backend bun-sqlgen generate 'src/repositories/**/*.ts' --migrations src/db/migrations",
    "check:queries": "bun run generate:queries --check",
    "check:types": "bun run check:queries && bun run --bun tsc",
    "test": "bun test backend/test",
    "test:binary": "bun test test/binary.test.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:",
    "@cfworker/json-schema": "4.1.1",
    "@context-use/open-sync": "workspace:*",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/openapi": "^1.4.15",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@ilbertt/better-auth-bun-sql": "^0.4.0",
    "@ilbertt/bun-sqlgen": "^0.5.1",
    "@open-sync/examples": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "better-auth": "catalog:",
    "elysia": "^1.4.30",
    "lucide-react": "^1.37.0",
    "range-parser": "^1.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vgpu": "0.5.0"
  },
  "devDependencies": {
    "@repo/build-tools": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/range-parser": "^1.2.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vgpu/wgsl": "0.5.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "catalog:",
    "vite": "^8.2.2"
  },
  "imports": {
    "#backend/*": "./backend/src/*",
    "#frontend/*": "./frontend/src/*"
  }
}
