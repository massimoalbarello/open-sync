{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "build:client"],
      "env": ["BUILD_TARGET"],
      "outputs": ["dist/app"]
    },
    "build:client": {
      "outputs": ["dist/public/**"]
    },
    "check:types": {
      "dependsOn": ["^check:types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "BETTER_AUTH_SECRET",
        "BASE_URL",
        "DATA_FOLDER",
        "PORT",
        "FRONTEND_PORT"
      ]
    }
  }
}
